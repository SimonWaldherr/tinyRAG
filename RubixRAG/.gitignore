settings.json
# Runtime settings of the r3-verify/r3-verify2 preview servers
# (.claude/launch.json) — auto-generated on first start, same category of
# local, never-committed state as settings.json above.
verify*-settings.json
# Same category: a tinysql-backed verify launch config's storage directory
# (e.g. verify-tinysql-data/, see .claude/launch.json's r3-verify-tinysql) —
# auto-generated on first start, never committed.
verify*-data/
# Feedback log (feedback.go) — runtime data next to settings.json, same
# category as settings.json/r3-data above, never committed.
r3-feedback.jsonl
